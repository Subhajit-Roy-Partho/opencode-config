        "llama3-groq-70b-tool-use": {
          "name": "llama3-groq-70b-tool-use"
        },
        "llama4-maverick-17b": {
          "name": "llama4-maverick-17b"
        },
        "llama4-scout-17b": {
          "name": "llama4-scout-17b"
        },
        "minimax-m2-7": {
          "name": "minimax-m2-7"
        },
        "minimax-m3": {
          "name": "minimax-m3"
        },
        "muse-glimmer-30b": {
          "name": "muse-glimmer-30b"
        },
        "north-mini-code": {
          "name": "north-mini-code"
        },
        "olmo3-32b-instruct": {
          "name": "olmo3-32b-instruct"
        },
        "olmo3-32b-think": {
          "name": "olmo3-32b-think"
        },
        "olmo3-7b-instruct": {
          "name": "olmo3-7b-instruct"
        },
        "olmo3-7b-think": {
          "name": "olmo3-7b-think"
        },
        "ornith-1-0-35b": {
          "name": "ornith-1-0-35b"
        },
        "qwen-agentworld-35b-a3b": {
          "name": "qwen-agentworld-35b-a3b"
        },
        "qwen3-235b-a22b-instruct-2507": {
          "name": "qwen3-235b-a22b-instruct-2507"
        },
        "qwen3-235b-a22b-thinking-2507": {
          "name": "qwen3-235b-a22b-thinking-2507"
