  "mcp": {
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "enabled": true
    },
    // Free, keyless paper/docs servers (fetched on first use via bunx/npx)
    "arxiv": {
      "type": "local",
      "command": ["bunx", "@cyanheads/arxiv-mcp-server"],
      "enabled": true
    },
    "openalex": {
      "type": "local",
      "command": ["bunx", "@cyanheads/openalex-mcp-server"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    // Self-hosted Firecrawl (../firecrawl docker stack, no-auth local instance).
    // Docs-first: API may not be up yet — agents must fall back, not error (see README).
    "firecrawl-mcp": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp@3.23.7"],
      "environment": { "FIRECRAWL_API_URL": "http://localhost:3002" },
      "enabled": true,
      "timeout": 30000
    },
    // Firecrawl Cloud (api.firecrawl.dev) — enables the research_* paper
    // tools that 404 on self-hosted. Key is sourced from the gitignored
    // .firecrawl-env file at spawn time (server env is unreliable), so no
    // secret is committed; restart opencode after config changes.
    "firecrawl-cloud": {
      "type": "local",
      "command": ["sh", "-c", "set -a; . ~/.config/opencode/.firecrawl-env; exec npx -y firecrawl-mcp@3.23.7"],
      "environment": {
        "FIRECRAWL_API_URL": "https://api.firecrawl.dev"
      },
      "enabled": true,
      "timeout": 30000
    },
    // Local weather (stdio MCP, no deps, wttr.in) — restored from pre-v2 backup.
    "weather": {
      "type": "local",
      "command": ["node", "/Users/subhajitrouy/.config/opencode/mcp-weather/weather.js"],
      "enabled": true
    },
    // Desktop/browser automation (fetched on first use via npx).
    "computer-use": {
      "type": "local",
      "command": ["npx", "--yes", "--prefer-offline", "@zavora-ai/computer-use-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--caps=devtools"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    }
  },
  "command": {
    "review": {
      "template": "Review the current changes (staged and unstaged) for bugs, security issues, performance problems, and code quality. Use the code-reviewer agent approach. List findings by severity.",
      "description": "Review code changes for issues"
    },
    "test": {
      "template": "Run the full test suite and analyze any failures. Focus on the failing tests, identify root causes, and suggest fixes.",
      "description": "Run tests and fix failures"
    },
    "plan": {
      "template": "Analyze the following request and create a detailed step-by-step implementation plan: $ARGUMENTS\n\nBreak it into phases with clear deliverables for each phase. Consider dependencies between phases.",
      "description": "Create an implementation plan",
      "agent": "architect"
    },
    "refactor": {
      "template": "Analyze the codebase for refactoring opportunities in the files related to: $ARGUMENTS\n\nLook for duplicated code, long functions, tight coupling, and violations of SOLID principles. Suggest and implement improvements.",
      "description": "Refactor code for quality"
    },
    "debug": {
      "template": "Debug the following issue: $ARGUMENTS\n\nTrace through the code, identify the root cause, and implement a fix.",
      "description": "Debug an issue",
      "agent": "debugger"
    },
    "document": {
      "template": "Generate comprehensive documentation for: $ARGUMENTS\n\nInclude JSDoc/doc comments, README sections, and usage examples. Follow the project's existing documentation style.",
      "description": "Generate documentation"
    },
    "security": {
      "template": "Perform a security audit on: $ARGUMENTS\n\nCheck for SQL injection, XSS, CSRF, authentication issues, sensitive data exposure, insecure dependencies, and other OWASP Top 10 vulnerabilities.",
      "description": "Security audit"
    },
    "perf": {
      "template": "Analyze performance of: $ARGUMENTS\n\nProfile for bottlenecks, memory leaks, unnecessary re-renders, N+1 queries, and inefficient algorithms. Suggest and implement optimizations.",
      "description": "Performance optimization"
    },
    "vision": {
      "template": "Analyze the attached image(s) and: $ARGUMENTS",
      "description": "Analyze images or screenshots with Muse Spark vision",
      "agent": "vision"
    },
    "queue": {
      "template": "Append the queued prompt to the prompt queue at `~/.config/opencode/.queue.md` using the `bash` tool (run exactly this, substituting the argument text and the current UTC timestamp):\n\n```bash\nprintf '\\n## %s\\n\\n%s\\n\\n---\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \"$ARGUMENTS\" >> ~/.config/opencode/.queue.md\n```\n\nRules:\n- $ARGUMENTS is the text to queue (everything after `/queue`). If $ARGUMENTS is empty, do NOT write to the queue — reply explaining that usage is `/queue <text>` and do nothing else.\n- Never interpret, execute, or answer the queued text now. Just store it.\n- After appending, count the `## ` entries in `~/.config/opencode/.queue.md` and reply with the position in queue (e.g. \"Queued at position 2 — it will run automatically once background work finishes. `/queue-status` to inspect, `/queue-run` to drain now, `/queue-clear` to drop.\").\n- Costs nothing extra: no agent or model switch is involved.",
      "description": "Queue a prompt to run after background work finishes"
    },
    "queue-run": {
      "template": "Drain the prompt queue file at `~/.config/opencode/.queue.md` now, oldest entry first, using the `read`, `bash`, and session prompt tools.\n\nSteps:\n1. Read `~/.config/opencode/.queue.md`. If it has no `## ` entries, reply \"Queue is empty — nothing to run.\" and stop.\n2. Take the OLDEST (first) `## ` entry. Remove exactly that entry from the file (keep the remaining entries intact; if it was the last entry, leave the file empty).\n3. Execute the popped entry's text as the user's next prompt (run it now, in this session).\n4. If entries remain, repeat from step 1 until the queue is empty or a background task is still busy (never run queued prompts while background work is in flight — leave the rest queued for the idle drain).",
      "description": "Manually drain the /queue prompt queue now"
    },
    "queue-status": {
      "template": "Read the prompt queue file at `~/.config/opencode/.queue.md` using the `read` tool and display its entries.\n\nRules:\n- If the file does not exist or has no `## ` entries, reply \"Queue is empty.\"\n- Otherwise list each entry numbered in order (oldest first) with its timestamp header and full text.\n- Do NOT execute or answer any queued entry — display only.",
      "description": "Show the pending /queue prompt queue"
    },
    "queue-clear": {
      "template": "Count the `## ` entries in `~/.config/opencode/.queue.md` with the `read` tool FIRST, then clear the prompt queue file using the `bash` tool:\n\n```bash\n: > ~/.config/opencode/.queue.md\n```\n\nThen reply confirming how many entries were dropped, e.g. \"Dropped 3 queued prompt(s).\" If the queue was already empty, reply \"Queue was already empty.\"",
      "description": "Drop all pending /queue prompts without running them"
    }
  }
}