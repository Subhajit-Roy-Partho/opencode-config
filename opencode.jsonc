        },
        "qwen35-122b-a10b": {
          "name": "qwen35-122b-a10b"
        },
        "qwen35-27b": {
          "name": "qwen35-27b"
        },
        "qwen35-35b-a3b": {
          "name": "qwen35-35b-a3b"
        },
        "qwen36-27b": {
          "name": "qwen36-27b"
        },
        "qwen36-35b-a3b": {
          "name": "qwen36-35b-a3b"
        },
        "qwen38-27b": {
          "name": "qwen38-27b"
        },
        "wan-2-2": {
          "name": "wan-2-2"
        },
        "whisper-large-v3": {
          "name": "whisper-large-v3"
        }
      }
    },
    // Output caps for Muse Spark Contributor tier (Meta Model API).
    // Without limit.output the gateway accounts the MODEL MAXIMUM against the
    // per-minute output-token budget -> "Output token rate limit exceeded...
    // charged the model maximum" (HTTP 429). 8000 is far above typical coding
    // usage (~300 tokens/req) and far below the 65.5K model max. Entries
    // deep-merge over built-in/remote provider definitions; context 1M per
    // vendor catalog.
    "opencode-go": {
      "models": {
        "muse-spark-1.3-contributor": {
          "limit": { "context": 1000000, "output": 8000 }
        }
      }
    },
    "opencode": {
      "models": {
        "muse-spark-1.3-contributor-free": {
          "limit": { "context": 1000000, "output": 8000 }
        }
      }
    },
    "nano-gpt": {
