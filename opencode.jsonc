{
  "$schema": "https://opencode.ai/config.json",
  // opencode v2 file shape: singular keys (plugin/agent/provider/command/permission,
  // flat mcp, npm+options) are canonical per the published schema. The plural
  // forms (plugins/agents/providers/...) appear only in `opencode debug config`
  // resolved output — do NOT rename file keys to plural, the schema rejects them.
  "autoupdate": true,
  // Big Pickle is a free stealth model on opencode Zen (https://opencode.ai/zen)
  "model": "opencode/big-pickle",
  "permission": "allow",
  "share": "manual",
  "compaction": {
    "auto": true
  },
  "plugin": [
    "./plugins/supermemory-bridge.js",
    "oh-my-opencode-slim",
    "./plugins/env-protection.js",
    "./plugins/memory-compaction.js",
    "./plugins/notification.js",
    "./plugins/queue-drain.js",
    "./plugins/shell-strategy.js",
    "./plugins/todo-tracker.js",
    "./plugins/afm-bare.js"
  ],
  "agent": {
    "afm": {
      "description": "Apple Foundation Models general chat — everyday Q&A answered from knowledge, no tools (use afm-agent for live data and tool use via tool-voice-proxy)",
      "mode": "primary",
      "model": "apple-fm/system",
      "prompt": "You are afm. Answer briefly from user input only.",
      "tools": {
        "*": false
      },
      "permission": {
        "skill": "deny",
        "task": "deny"
      }
    },
    "afm-agent": {
      "description": "Apple Foundation Models via tool-voice-proxy — narrated JSON envelopes translated into real tool calls (bash/webfetch/weather MCP)",
      "mode": "primary",
      "model": "apple-fm/system",
      "tools": {
        "*": false,
        "bash": true,
        "webfetch": true,
        "weather_get_temperature": true
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices, security, performance, and maintainability",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "You are a senior code reviewer. Focus on security vulnerabilities, performance bottlenecks, maintainability, and adherence to best practices. Provide actionable feedback with specific line references. Rate severity of each issue as critical, warning, or suggestion.",
      "permission": {
        "edit": "deny"
      }
    },
    "architect": {
      "description": "Designs system architecture and creates implementation plans",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "You are a software architect. Analyze requirements, design system architecture, define data models, API contracts, and create step-by-step implementation plans. Always consider scalability, maintainability, and trade-offs. Output structured plans with clear phases.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "test-writer": {
      "description": "Writes comprehensive tests for existing and new code",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "You are a test engineer. Write comprehensive tests covering happy paths, edge cases, error handling, and boundary conditions. Follow the project's existing test patterns and conventions. Aim for high coverage but prioritize meaningful assertions over line coverage."
    },
    "debugger": {
      "description": "Debugs issues by analyzing code, logs, and error traces",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "You are a debugging specialist. Systematically trace issues from error messages through the call stack. Identify root causes, not symptoms. Suggest minimal fixes and explain why the bug occurred. Verify your hypothesis before suggesting fixes."
    },
    "vision": {
      "description": "Analyzes images, screenshots, diagrams, and visual content using Muse Spark vision",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "You are a visual analysis expert. Analyze images, screenshots, diagrams, UI mockups, and other visual content in detail. Identify code, UI patterns, errors, architecture diagrams, or data in the image. Connect visual observations to the codebase and provide actionable insights or code changes."
    },
    // Lane agents (oh-my-opencode-slim): per-task model selection.
    // - vision stays on Muse Spark 1.3 contributor-free (Zen): explicit choice.
    // - every other lane runs Muse Spark 1.3 contributor on Go
    //   (opencode/muse-spark-1.3-contributor-free).
    // Bare {model} entries deep-merge over the plugin's agent definitions.
    "explorer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "fixer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "librarian": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "oracle": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "designer": {
      "model": "opencode/muse-spark-1.3-contributor-free"
    },
    "deep-research": {
      "model": "opencode-go/muse-spark-1.3-contributor"
    }
  },
  "provider": {
    "apple-fm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Apple Foundation Models",
      "options": {
        "baseURL": "http://127.0.0.1:1976/v1"
      },
      "models": {
        "pcc": {
          "name": "Apple FM (Private Cloud Compute)"
        },
        "system": {
          "name": "Apple FM (on-device)"
        }
      }
    },
    "asu": {
