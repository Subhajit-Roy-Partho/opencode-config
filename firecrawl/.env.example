# Local-only Firecrawl env template. Copy to .env (already done for you).
# No secrets here: USE_DB_AUTHENTICATION=false, loopback-bound, dev defaults.

# Host port for the API (bound to 127.0.0.1 only in docker-compose.yml)
PORT=3002
INTERNAL_PORT=3002

# No-auth local mode
USE_DB_AUTHENTICATION=false

# Internal service URLs (defaults match compose service names)
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=redis://redis:6379
PLAYWRIGHT_MICROSERVICE_URL=http://playwright-service:3000/scrape

# Postgres (nuq queue backend). Local dev defaults only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=nuq-postgres
POSTGRES_PORT=5432

# Concurrency tuning
NUM_WORKERS_PER_QUEUE=8
CRAWL_CONCURRENT_REQUESTS=10
MAX_CONCURRENT_JOBS=5
BROWSER_POOL_SIZE=5

# Queue admin UI key (local-only; change if ever exposed)
BULL_AUTH_KEY=CHANGEME

# Optional: uncomment to enable AI features (/extract, JSON format on scrape)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# MODEL_NAME=
# OLLAMA_BASE_URL=http://host.docker.internal:11434/api

# Optional: proxy / search
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
# SEARXNG_ENDPOINT=
